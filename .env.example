# MindGraph Open configuration (ADR-013).
#
# Copy to `.env` to override defaults. Docker Compose reads `.env`
# automatically. Every value below has a working local default, so
# `docker compose up` also works without a `.env` file.
#
# Never commit `.env` or real credentials. `.env` is git-ignored.

# --- Published ports (bound to 127.0.0.1 only) -----------------------------
MINDGRAPH_WEB_PORT=3000
MINDGRAPH_CORE_PORT=8080

# --- PostgreSQL (application metadata) --------------------------------------
# Reachable only inside the Docker network. Use URL-safe characters in the
# password because it is embedded in MINDGRAPH_DATABASE_URL. Postgres applies
# these values only when its volume is first created. Changing them later
# needs a fresh volume (`docker compose down -v`), which DELETES all graphs
# and metadata: back up first (docs/operations/backup-restore.md).
MINDGRAPH_POSTGRES_USER=mindgraph
MINDGRAPH_POSTGRES_PASSWORD=change-me-local-only
MINDGRAPH_POSTGRES_DB=mindgraph
# Connection pool size of mindgraph-core (1-100).
MINDGRAPH_DATABASE_MAX_CONNECTIONS=10

# --- HugeGraph -----------------------------------------------------------------
# Java heap of the bundled HugeGraph (internal only). 1g suits the demos and
# small graphs; raise it for larger graphs if HugeGraph logs OutOfMemoryError.
MINDGRAPH_HUGEGRAPH_HEAP=1g

# --- Dataset ingestion (M4) --------------------------------------------------
# Uploads are stored in the `mindgraph-data` volume (MINDGRAPH_DATA_DIR=/data
# inside the container). Every limit is enforced before or while reading.
# Largest accepted upload in bytes (default 50 MiB, at most 1 GiB).
MINDGRAPH_MAX_UPLOAD_BYTES=52428800
# Largest number of records per dataset (default 100000).
MINDGRAPH_MAX_INGESTION_RECORDS=100000
# Records per graph write batch (1-5000).
MINDGRAPH_INGESTION_BATCH_SIZE=500
# Background jobs running at the same time (1-16).
MINDGRAPH_JOB_CONCURRENCY=2

# --- AI Graph Builder (M5) ---------------------------------------------------
# Leave MINDGRAPH_LLM_PROVIDER empty to run without AI: upload, analysis,
# manual ontology/mapping and ingestion keep working.
#
# The only provider kind is `openai_compatible`: any server that implements
# POST {base_url}/chat/completions. When you request a suggestion, MindGraph
# sends the dataset's field names, inferred types, null counts and a few
# sample values/rows (never the file) plus the graph's ontology to it.
#
# Hosted example:
#   MINDGRAPH_LLM_BASE_URL=https://api.openai.com/v1
#   MINDGRAPH_LLM_MODEL=<model name>
#   MINDGRAPH_LLM_API_KEY=<your key>
# Local model with Ollama on the host (no key needed):
#   MINDGRAPH_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   (Podman: http://host.containers.internal:11434/v1)
#   MINDGRAPH_LLM_MODEL=qwen3:8b
MINDGRAPH_LLM_PROVIDER=
MINDGRAPH_LLM_BASE_URL=
MINDGRAPH_LLM_MODEL=
# Optional: some local servers need no key. Never commit a real key.
MINDGRAPH_LLM_API_KEY=
# Per attempt (1-600).
MINDGRAPH_LLM_TIMEOUT_SECONDS=60
MINDGRAPH_LLM_MAX_OUTPUT_TOKENS=4096
# Retries after a 429, a 5xx or a dropped connection (0-2).
MINDGRAPH_LLM_MAX_RETRIES=2
# Ask for JSON mode (response_format=json_object). Turn off for servers that
# reject it; output is validated strictly either way.
MINDGRAPH_LLM_JSON_MODE=true
# Core side: time allowed per suggestion call, repair attempts (0-2) when
# Rust validation rejects a suggestion, and AI jobs running at the same time
# (1-8). AI jobs have their own workers, so slow model calls never hold up
# analysis or ingestion jobs.
MINDGRAPH_AI_TIMEOUT_SECONDS=300
MINDGRAPH_AI_MAX_REPAIR_ATTEMPTS=1
MINDGRAPH_AI_JOB_CONCURRENCY=2

# --- Ask MindGraph / GraphRAG (M7) -----------------------------------------
# Uses the same LLM provider as the AI Graph Builder: leave
# MINDGRAPH_LLM_PROVIDER empty and Ask MindGraph answers 503 AI_NOT_CONFIGURED
# while everything else keeps working. Each question sends the question, the
# ontology, the selected entities' properties and the retrieved evidence
# (at most 150 entities, 48 KiB) to the provider; use a local model for
# sensitive graphs. Deadline of one question (two model calls plus bounded
# retrieval, 1-600 s) and questions answered at the same time (1-16):
MINDGRAPH_GRAPHRAG_TIMEOUT_SECONDS=120
MINDGRAPH_GRAPHRAG_CONCURRENCY=2

# --- MCP server (M8) --------------------------------------------------------
# Not used by Docker Compose. Your MCP client (Claude Code, Codex, Cursor)
# starts `mindgraph-mcp` on your machine and passes these variables in its own
# configuration; see docs/mcp/README.md. The server reads one graph through
# Core's REST API on a loopback address and never needs database credentials.
# MINDGRAPH_MCP_GRAPH_ID=            # required: the graph id (UUIDv7)
# MINDGRAPH_MCP_CORE_URL=http://127.0.0.1:8080
# MINDGRAPH_MCP_TIMEOUT_SECONDS=30
# MINDGRAPH_MCP_MAX_RESULT_BYTES=262144
# ask_graph (GraphRAG) sends graph evidence to the model provider above.
# MINDGRAPH_MCP_ENABLE_ASK=false
# MINDGRAPH_MCP_ASK_TIMEOUT_SECONDS=150

# --- Telemetry ---------------------------------------------------------------
# Off by default. MindGraph never collects graph contents, datasets, prompts
# or entity data.
MINDGRAPH_TELEMETRY_ENABLED=false

# --- Logging -----------------------------------------------------------------
RUST_LOG=info

# --- Running mindgraph-core on the host (outside Docker) ---------------------
# Docker Compose sets these for its own containers. Set them only when you
# run `cargo run -p mindgraph-api --bin mindgraph-core` yourself, together
# with a compose override that publishes Postgres and HugeGraph to the host.
# MINDGRAPH_DATABASE_URL and MINDGRAPH_HUGEGRAPH_URL are required; HugeGraph
# URLs must not contain credentials. MINDGRAPH_DATA_DIR defaults to ./data.
# MINDGRAPH_CORE_BIND_ADDR=127.0.0.1:8080
# MINDGRAPH_DATABASE_URL=postgres://mindgraph:change-me-local-only@localhost:5432/mindgraph
# MINDGRAPH_HUGEGRAPH_URL=http://localhost:8081
# MINDGRAPH_HUGEGRAPH_GRAPHSPACE=DEFAULT
# MINDGRAPH_HUGEGRAPH_GRAPH=hugegraph
# MINDGRAPH_DATA_DIR=./data
# MINDGRAPH_AI_URL=http://localhost:8000
