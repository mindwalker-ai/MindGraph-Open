# Environment of the isolated smoke-test stack (scripts/smoke-stack.sh).
#
# Passed with --env-file, so Compose does not read your own `.env`: the test
# stack never sees your model provider or API key, and no model is called.
# Ports differ from the defaults so the test stack can run next to yours.

MINDGRAPH_WEB_PORT=23000
MINDGRAPH_CORE_PORT=28180

# AI stays unconfigured: the manual flows must work without it.
MINDGRAPH_LLM_PROVIDER=
MINDGRAPH_LLM_BASE_URL=
MINDGRAPH_LLM_MODEL=
MINDGRAPH_LLM_API_KEY=

# Throwaway credentials for a throwaway database on the internal network.
MINDGRAPH_POSTGRES_USER=mindgraph
MINDGRAPH_POSTGRES_PASSWORD=smoke-test-only
MINDGRAPH_POSTGRES_DB=mindgraph

MINDGRAPH_TELEMETRY_ENABLED=false
RUST_LOG=info

# Same as the default; the demos need far less.
MINDGRAPH_HUGEGRAPH_HEAP=1g
